{
  "name": "calvient/arbol",
  "description": "A simple data visualization tool for Laravel apps.",
  "keywords": [
    "Calvient",
    "laravel",
    "arbol"
  ],
  "homepage": "https://github.com/calvient/arbol",
  "license": "MIT",
  "authors": [
    {
      "name": "Jonathan Minson",
      "email": "jonathan@calvient.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0||^13.0",
    "inertiajs/inertia-laravel": "^3.0",
    "spatie/laravel-package-tools": "^1.93"
  },
  "require-dev": {
    "larastan/larastan": "^3.10",
    "laravel/pint": "^1.14",
    "nunomaduro/collision": "^8.9.4",
    "orchestra/testbench": "^10.9||^11.1",
    "pestphp/pest": "^4.5",
    "pestphp/pest-plugin-arch": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.1",
    "phpstan/extension-installer": "^1.3",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "spatie/laravel-ray": "^1.43"
  },
  "autoload": {
    "psr-4": {
      "Calvient\\Arbol\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Calvient\\Arbol\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse src tests",
    "test": "vendor/bin/pest",
    "test-coverage": "vendor/bin/pest --coverage",
    "format": "vendor/bin/pint"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Calvient\\Arbol\\ArbolServiceProvider"
      ],
      "aliases": {
        "Arbol": "Calvient\\Arbol\\Facades\\Arbol"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
