{
  "name": "ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite build --mode=development --watch",
    "build": "vite build",
    "lint": "eslint resources/ts tests/ts --ext .ts,.tsx --quiet",
    "lint-fix": "eslint resources/ts tests/ts --ext .ts,.tsx --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pint": "./vendor/bin/pint",
    "format": "prettier --write resources/ts/** && yarn pint"
  },
  "dependencies": {},
  "devDependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.10.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@inertiajs/react": "^3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@tanstack/react-table": "^8.17.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "framer-motion": "^13.1.0",
    "jsdom": "^27.4.0",
    "laravel-vite-plugin": "^2.0.1",
    "prettier": "^3.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.2.1",
    "react-is": "^19.0.0",
    "recharts": "^3.0.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.2",
